\section{Lagrangian Formulation}

The dynamics of the inverted pendulum are derived using the
Euler--Lagrange formulation. The Lagrangian is defined as
\begin{equation}
    \mathcal{L} = T - V,
    \label{eq:lagrangian}
\end{equation}
where $T$ is the total kinetic energy and $V$ is the gravitational
potential energy.

For a system with generalized coordinates $q_i$, the
Euler--Lagrange equations are
\begin{equation}
    \frac{\mathrm{d}}{\mathrm{d}t}
    \left(
        \frac{\partial \mathcal{L}}
        {\partial \dot{q}_i}
    \right)
    -
    \frac{\partial \mathcal{L}}
    {\partial q_i}
    =
    Q_i,
    \label{eq:euler_lagrange}
\end{equation}
where $Q_i$ is the generalized nonconservative force associated with
$q_i$.

\subsection{Coordinate System}

The system is described using an inertial Cartesian coordinate frame
$\mathcal{F}_I$. The $x$ axis is horizontal and positive to the right,
while the $z$ axis is vertical and positive upward.

The position of the wheel axle is
\begin{equation}
    \bm{r}_{\mathrm{w}}
    =
    \begin{bmatrix}
        x \\
        z
    \end{bmatrix},
    \label{eq:wheel_position}
\end{equation}
where $z$ is constant.

The center of mass of the pendulum body is located at
\begin{equation}
    \bm{r}_{\mathrm{b}}
    =
    \begin{bmatrix}
        x_{\mathrm b} \\
        z_{\mathrm b}
    \end{bmatrix}
    =
    \begin{bmatrix}
        x + \ell\sin\theta \\
        z + \ell\cos\theta
    \end{bmatrix},
    \label{eq:body_position}
\end{equation}
where $\ell$ is the distance from the wheel axle to the center of mass
of the pendulum body.

The angle $\theta$ is measured clockwise from the positive $z$ axis.
Therefore,
\begin{equation}
    \theta = 0
\end{equation}
corresponds to the upright configuration of the inverted pendulum.

The generalized coordinates are
\begin{equation}
    q_1 = x,
    \qquad
    q_2 = \theta,
    \qquad
    q_3 = \phi_{\mathrm w},
    \label{eq:generalized_coordinates}
\end{equation}
where $\phi_{\mathrm w}$ is the angular position of the wheel.

The wheel angular velocity is
\begin{equation}
    \omega_{\mathrm w}
    =
    \dot{\phi}_{\mathrm w}.
    \label{eq:wheel_angular_velocity}
\end{equation}

\subsection{Rolling Constraint}

Assuming pure rolling without slipping, the wheel translational and
rotational velocities satisfy
\begin{equation}
    \dot{x}
    =
    r_{\mathrm w}\dot{\phi}_{\mathrm w},
    \label{eq:rolling_constraint_velocity}
\end{equation}
where $r_{\mathrm w}$ is the wheel radius.

The corresponding position constraint is
\begin{equation}
    x-r_{\mathrm w}\phi_{\mathrm w}=C,
    \label{eq:rolling_constraint_position}
\end{equation}
where $C$ is a constant determined by the initial configuration.

Because the rolling constraint eliminates one degree of freedom,
$\phi_{\mathrm w}$ may be eliminated from the final equations of motion
using
\begin{equation}
    \dot{\phi}_{\mathrm w}
    =
    \frac{\dot{x}}{r_{\mathrm w}},
    \qquad
    \ddot{\phi}_{\mathrm w}
    =
    \frac{\ddot{x}}{r_{\mathrm w}}.
    \label{eq:rolling_constraint_acceleration}
\end{equation}

\subsection{Kinetic Energy}

The velocity of the pendulum-body center of mass is obtained by
differentiating \eqref{eq:body_position}:
\begin{equation}
    \dot{x}_{\mathrm b}
    =
    \dot{x}
    +
    \ell\dot{\theta}\cos\theta,
    \label{eq:body_x_velocity}
\end{equation}
and
\begin{equation}
    \dot{z}_{\mathrm b}
    =
    -\ell\dot{\theta}\sin\theta.
    \label{eq:body_z_velocity}
\end{equation}

Therefore, the squared speed of the pendulum-body center of mass is
\begin{align}
    v_{\mathrm b}^2
    &=
    \dot{x}_{\mathrm b}^{\,2}
    +
    \dot{z}_{\mathrm b}^{\,2}
    \nonumber\\
    &=
    \dot{x}^{\,2}
    +
    2\ell\dot{x}\dot{\theta}\cos\theta
    +
    \ell^2\dot{\theta}^{\,2}.
    \label{eq:body_speed}
\end{align}

The translational kinetic energy of the wheel and axle assembly is
\begin{equation}
    T_{\mathrm w,trans}
    =
    \frac{1}{2}m_{\mathrm w}\dot{x}^{\,2}.
    \label{eq:wheel_translational_energy}
\end{equation}

The translational kinetic energy of the pendulum body is
\begin{equation}
    T_{\mathrm b,trans}
    =
    \frac{1}{2}m_{\mathrm b}
    \left(
        \dot{x}^{\,2}
        +
        2\ell\dot{x}\dot{\theta}\cos\theta
        +
        \ell^2\dot{\theta}^{\,2}
    \right).
    \label{eq:body_translational_energy}
\end{equation}

The rotational kinetic energy of the pendulum body is
\begin{equation}
    T_{\mathrm b,rot}
    =
    \frac{1}{2}I_{\mathrm b}\dot{\theta}^{\,2},
    \label{eq:body_rotational_energy}
\end{equation}
and the rotational kinetic energy of the wheel is
\begin{equation}
    T_{\mathrm w,rot}
    =
    \frac{1}{2}I_{\mathrm w}\dot{\phi}_{\mathrm w}^{\,2}.
    \label{eq:wheel_rotational_energy}
\end{equation}

Thus, the total kinetic energy is
\begin{align}
    T
    &=
    T_{\mathrm w,trans}
    +
    T_{\mathrm b,trans}
    +
    T_{\mathrm b,rot}
    +
    T_{\mathrm w,rot}
    \nonumber\\
    &=
    \frac{1}{2}
    (m_{\mathrm b}+m_{\mathrm w})
    \dot{x}^{\,2}
    +
    m_{\mathrm b}\ell
    \dot{x}\dot{\theta}\cos\theta
    \nonumber\\
    &\quad
    +
    \frac{1}{2}
    \left(
        I_{\mathrm b}
        +
        m_{\mathrm b}\ell^2
    \right)
    \dot{\theta}^{\,2}
    +
    \frac{1}{2}
    I_{\mathrm w}\dot{\phi}_{\mathrm w}^{\,2}.
    \label{eq:total_kinetic_energy}
\end{align}

Applying the rolling constraint from \eqref{eq:rolling_constraint_acceleration}
gives
\begin{equation}
    T
    =
    \frac{1}{2}
    \left(
        m_{\mathrm b}
        +
        m_{\mathrm w}
        +
        \frac{I_{\mathrm w}}{r_{\mathrm w}^{\,2}}
    \right)
    \dot{x}^{\,2}
    +
    m_{\mathrm b}\ell
    \dot{x}\dot{\theta}\cos\theta
    +
    \frac{1}{2}
    \left(
        I_{\mathrm b}
        +
        m_{\mathrm b}\ell^2
    \right)
    \dot{\theta}^{\,2}.
    \label{eq:constrained_kinetic_energy}
\end{equation}

\subsection{Potential Energy}

The gravitational potential energy of the pendulum body is
\begin{equation}
    V
    =
    m_{\mathrm b}g z_{\mathrm b}.
    \label{eq:potential_general}
\end{equation}

Substituting \eqref{eq:body_position} gives
\begin{equation}
    V
    =
    m_{\mathrm b}g
    \left(
        z+\ell\cos\theta
    \right).
    \label{eq:potential_full}
\end{equation}

Since $z$ is constant, the term $m_{\mathrm b}gz$ is constant and does
not affect the equations of motion. It can therefore be omitted,
yielding
\begin{equation}
    V
    =
    m_{\mathrm b}g\ell\cos\theta.
    \label{eq:potential_energy}
\end{equation}

\subsection{Constrained Lagrangian}

Using \eqref{eq:constrained_kinetic_energy} and
\eqref{eq:potential_energy}, the constrained Lagrangian is
\begin{align}
    \mathcal{L}
    &=
    \frac{1}{2}
    \left(
        m_{\mathrm b}
        +
        m_{\mathrm w}
        +
        \frac{I_{\mathrm w}}{r_{\mathrm w}^{\,2}}
    \right)
    \dot{x}^{\,2}
    +
    m_{\mathrm b}\ell
    \dot{x}\dot{\theta}\cos\theta
    \nonumber\\
    &\quad
    +
    \frac{1}{2}
    \left(
        I_{\mathrm b}
        +
        m_{\mathrm b}\ell^2
    \right)
    \dot{\theta}^{\,2}
    -
    m_{\mathrm b}g\ell\cos\theta.
    \label{eq:constrained_lagrangian}
\end{align}

\subsection{Equations of Motion}

The motor applies equal and opposite torques to the wheel and pendulum
body. Let $M_{\mathrm{mot}}$ denote the motor torque, with positive
torque defined in the positive $\theta$ direction on the pendulum body.

The generalized motor torque acting on the pendulum is therefore
\begin{equation}
    Q_{\theta}
    =
    M_{\mathrm{mot}}.
    \label{eq:pendulum_motor_torque}
\end{equation}

Because the wheel and pendulum body experience equal and opposite
motor torques, the corresponding wheel torque is
\begin{equation}
    Q_{\phi_{\mathrm w}}
    =
    -M_{\mathrm{mot}}.
    \label{eq:wheel_motor_torque}
\end{equation}

After applying the rolling constraint, the motor contributes an
effective generalized force in the $x$ direction of
\begin{equation}
    Q_x
    =
    -\frac{M_{\mathrm{mot}}}{r_{\mathrm w}}.
    \label{eq:effective_motor_force}
\end{equation}

The signs in these equations follow the convention that positive
$\theta$ and positive $M_{\mathrm{mot}}$ correspond to clockwise
rotation of the pendulum from the upright position.

\subsubsection{Translational Equation}

Applying the Euler--Lagrange equation to $x$ gives
\begin{equation}
    \left(
        m_{\mathrm b}
        +
        m_{\mathrm w}
        +
        \frac{I_{\mathrm w}}{r_{\mathrm w}^{\,2}}
    \right)
    \ddot{x}
    +
    m_{\mathrm b}\ell\cos\theta
    \ddot{\theta}
    -
    m_{\mathrm b}\ell
    \sin\theta\,\dot{\theta}^{\,2}
    =
    -\frac{M_{\mathrm{mot}}}{r_{\mathrm w}}.
    \label{eq:translation_eom}
\end{equation}

\subsubsection{Pendulum Angular Equation}

Applying the Euler--Lagrange equation to $\theta$ gives
\begin{equation}
    \left(
        I_{\mathrm b}
        +
        m_{\mathrm b}\ell^2
    \right)
    \ddot{\theta}
    +
    m_{\mathrm b}\ell\cos\theta
    \ddot{x}
    -
    m_{\mathrm b}g\ell\sin\theta
    =
    M_{\mathrm{mot}}.
    \label{eq:angular_eom}
\end{equation}

The first term represents the rotational inertia of the pendulum
body, the second represents translational--rotational coupling, and
the third represents the gravitational torque.

\subsection{Nonlinear State Equations}

The nonlinear equations of motion can be written in matrix form as
\begin{equation}
    \bm{M}(\theta)
    \begin{bmatrix}
        \ddot{x}\\
        \ddot{\theta}
    \end{bmatrix}
    +
    \bm{h}(\theta,\dot{\theta})
    +
    \bm{g}(\theta)
    =
    \bm{B}M_{\mathrm{mot}},
    \label{eq:matrix_form}
\end{equation}
where
\begin{equation}
    \bm{M}(\theta)
    =
    \begin{bmatrix}
        m_{\mathrm b}
        +
        m_{\mathrm w}
        +
        I_{\mathrm w}/r_{\mathrm w}^{\,2}
        &
        m_{\mathrm b}\ell\cos\theta
        \\[4pt]
        m_{\mathrm b}\ell\cos\theta
        &
        I_{\mathrm b}
        +
        m_{\mathrm b}\ell^2
    \end{bmatrix},
    \label{eq:mass_matrix}
\end{equation}
\begin{equation}
    \bm{h}(\theta,\dot{\theta})
    =
    \begin{bmatrix}
        -m_{\mathrm b}\ell
        \sin\theta\,\dot{\theta}^{\,2}
        \\
        0
    \end{bmatrix},
    \label{eq:velocity_vector}
\end{equation}
\begin{equation}
    \bm{g}(\theta)
    =
    \begin{bmatrix}
        0
        \\
        -m_{\mathrm b}g\ell\sin\theta
    \end{bmatrix},
    \label{eq:gravity_vector}
\end{equation}
and
\begin{equation}
    \bm{B}
    =
    \begin{bmatrix}
        -1/r_{\mathrm w}
        \\
        1
    \end{bmatrix}.
    \label{eq:input_vector}
\end{equation}

\subsection{Linearization About the Upright Equilibrium}

For small angular displacements about the upright equilibrium,
\begin{equation}
    \theta \approx 0,
    \qquad
    \sin\theta\approx\theta,
    \qquad
    \cos\theta\approx1.
    \label{eq:small_angle}
\end{equation}

Neglecting second-order terms such as
$\theta\dot{\theta}^{\,2}$, the linearized equations become
\begin{equation}
    \left(
        m_{\mathrm b}
        +
        m_{\mathrm w}
        +
        \frac{I_{\mathrm w}}{r_{\mathrm w}^{\,2}}
    \right)
    \ddot{x}
    +
    m_{\mathrm b}\ell\ddot{\theta}
    =
    -\frac{M_{\mathrm{mot}}}{r_{\mathrm w}},
    \label{eq:linear_translation}
\end{equation}
and
\begin{equation}
    m_{\mathrm b}\ell\ddot{x}
    +
    \left(
        I_{\mathrm b}
        +
        m_{\mathrm b}\ell^2
    \right)
    \ddot{\theta}
    -
    m_{\mathrm b}g\ell\theta
    =
    M_{\mathrm{mot}}.
    \label{eq:linear_angular}
\end{equation}

